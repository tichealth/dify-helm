# Terraform Variables for Dify AKS Deployment
# Copy this file to terraform.tfvars and fill in your values
# NOTE: terraform.tfvars is git-ignored - your actual values will not be committed

project_name = "dify"
location     = "australiaeast"

# Optional: use existing RG by name, else leave blank
resource_group_name = ""

# AKS
node_count         = 1
vm_size            = "Standard_D4s_v5"

# Azure Storage variables retained for the Terraform backend/future wiring.
# Current Dify file persistence uses Azure File PVCs.
azure_blob_account_name   = "yourbackendaccount"
azure_blob_account_key    = "REPLACE_WITH_YOUR_KEY"
azure_blob_container_name = "difydata"
azure_blob_account_url    = "https://yourbackendaccount.blob.core.windows.net"

# Optional tags
tags = {
  env     = "dev"
  project = "dify"
}
